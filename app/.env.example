VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Expiración de sesión por inactividad (minutos; 0 = desactivado). Default 30.
VITE_SESSION_IDLE_MINUTES=30
# Segundos antes del cierre para mostrar el aviso "Continuar sesión". Default 60.
VITE_SESSION_WARNING_SECONDS=60
# Log detallado de sesión/refresh de Supabase. Solo en dev; default false.
VITE_SUPABASE_DEBUG=false
# Correo de contacto comercial para el enlace "Solicitar propuesta" del landing.
# Si queda vacío, el botón no se muestra y se muestra el texto de contacto alternativo.
VITE_CONTACTO_EMAIL=
# Habilita el inicio de sesión con correo y contraseña (Supabase). Default false.
VITE_AUTH_EMAIL_PASSWORD_ENABLED=false
# Habilita el inicio de sesión con Google. Default true.
VITE_AUTH_GOOGLE_ENABLED=true